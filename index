let tab="now", fStatus="todo", openSet=new Set(), uGroup="all", uStat="all";
const PG={all:1,ready:1,almost:1,unl:1};
function pager(key,total,per){
  const pages=Math.max(1,Math.ceil(total/per)); if(PG[key]>pages) PG[key]=pages; if(PG[key]<1) PG[key]=1;
  if(pages<=1) return "";
  const p=PG[key];
  return `<div class="pager"><button class="chip" data-pg="${key}:${p-1}" ${p<=1?"disabled":""}>‹ Anterior</button><span>Página ${p} de ${pages}</span><button class="chip" data-pg="${key}:${p+1}" ${p>=pages?"disabled":""}>Próxima ›</button></div>`;
}
const pageOf=(key,arr,per)=>arr.slice((PG[key]-1)*per, PG[key]*per);
function rangeTxt(key,total,per,word){
  if(!total) return "";
  const a=(PG[key]-1)*per+1, b=Math.min(total,PG[key]*per);
  return total>per ? `${total} ${word} · mostrando ${a}–${b}` : `${total} ${word}`;
}
const RANK={ready:0,almost:1,lock:2,event:3,done:4};
function renderNow(){
  const rows = LETTERS.map(l=>({l,st:status(l)}));
  const ready = rows.filter(r=>r.st.s==="ready").map(r=>r.l);
  const almost = rows.filter(r=>r.st.s==="almost");
  const anyItems = ITEMS.some(i=>S.items[i[0]]);
  let h="";
  if(!anyItems){
    h += `<div class="welcome"><p><b>Primeiro passo:</b> marque em <b>Meu jogo</b> os itens do jardim que você tem, sua avaliação e o que já desbloqueou.</p><p class="note">Depois, marque as cartas que já recebeu na aba Cartas. Aqui vai aparecer a melhor combinação para colocar no jardim.</p><div><button class="btn" data-goto="me">Ir para Meu jogo</button></div></div>`;
  }
  const sug = suggestions(ready);
  if(sug.length){
    h += `<div><h2>O que colocar no jardim</h2><p class="hint">A carta que chega é sorteada entre as possíveis. Deixe a combinação até essas cartas chegarem e depois passe para a próxima.</p><div style="display:flex;flex-direction:column;gap:10px">`+
      sug.map((s,i)=>`<div class="combo${i===0?' top':''}"><div class="combo-head"><span class="combo-n">${i===0?'Melhor agora':'Depois, tente'}</span><span class="combo-n" style="color:var(--muted)">${s.ls.length} carta${s.ls.length>1?'s':''}</span></div>
        <div class="slots">${s.slots.map(x=>x==="*"?`<span class="slot any">qualquer</span>`:`<span class="slot">${dot(x)}${esc(x)}</span>`).join("")}</div>
        <ul>${s.ls.map(l=>`<li>${esc(l.name)}${l.seasonal?` <span class="tag">${esc(l.seasonal.replace(/^from /,""))}</span>`:""}</li>`).join("")}</ul></div>`).join("")+`</div></div>`;
  }
  const top=document.getElementById("nowTop"); top.innerHTML=h; top.hidden=!h; restoreOpen(top);

  // lists with search, group filter, sort and pages
  const nq=document.getElementById("nq").value.trim().toLowerCase(), nsec=document.getElementById("nsec").value, nsort=document.getElementById("nsort").value;
  const match=r=>(!nsec||r.l.section===nsec) && (!nq||(r.l.name+" "+r.l.group+" "+r.l.preUnlocks.join(" ")).toLowerCase().includes(nq));
  const cmp = nsort==="az" ? (a,b)=>a.l.name.localeCompare(b.l.name) : (a,b)=>b.l.bonus-a.l.bonus||a.l.name.localeCompare(b.l.name);
  const R = rows.filter(r=>r.st.s==="ready").filter(match).sort(cmp);
  const A = almost.filter(match).sort(cmp);
  const PER=10, filtered = nq||nsec;
  document.getElementById("nowTools").hidden = !(ready.length+almost.length);
  let L="";
  const pR=pager("ready",R.length,PER), pA=pager("almost",A.length,PER);
  L += `<div><h2>Prontas para pegar <span class="n">${R.length}</span></h2>${R.length>PER?`<p class="count" style="margin:0 0 8px">${rangeTxt("ready",R.length,PER,"cartas")}</p>`:""}<div class="sheet">${R.length? pageOf("ready",R,PER).map(r=>rowHtml(r.l)).join("") : `<div class="empty">${filtered?"Nenhuma carta pronta com essa busca.":"Nenhuma ainda. Marque seus itens e desbloqueios em Meu jogo."}</div>`}</div>${pR}</div>`;
  L += `<div><h2>Falta só 1 coisa <span class="n">${A.length}</span></h2>${A.length>PER?`<p class="count" style="margin:0 0 8px">${rangeTxt("almost",A.length,PER,"cartas")}</p>`:""}<div class="sheet">${A.length? pageOf("almost",A,PER).map(r=>rowHtml(r.l).replace('</b>', `</b><em>Falta: ${esc(missingLine(r.st))}</em>`)).join("") : `<div class="empty">${filtered?"Nada com essa busca.":"Nada aqui por enquanto."}</div>`}</div>${pA}</div>`;
  const ls=document.getElementById("nowLists"); ls.innerHTML=L; restoreOpen(ls);
}
const FILTERS=[["todo","Faltando"],["ready","Prontas"],["lock","Bloqueadas"],["event","Só evento"],["done","Recebidas"],["all","Todas"]];
function renderAll(){
  document.getElementById("fstatus").innerHTML = FILTERS.map(([k,t])=>`<button class="chip" data-f="${k}" aria-pressed="${fStatus===k}">${t}</button>`).join("");
  const q=document.getElementById("q").value.trim().toLowerCase(), sec=document.getElementById("fsec").value,
        item=document.getElementById("fitem").value, sort=document.getElementById("fsort").value;
  const arr=[];
  LETTERS.forEach(l=>{
    if(sec && l.section!==sec) return;
    if(item && !l.combos.some(c=>c.includes(item))) return;
    if(q && !(l.name+" "+l.group+" "+l.preUnlocks.join(" ")).toLowerCase().includes(q)) return;
    const st=status(l), s=st.s;
    const ok = fStatus==="all" || (fStatus==="todo"? s!=="done" : fStatus==="lock"? (s==="lock"||s==="almost") : s===fStatus);
    if(ok) arr.push({l,st});
  });
  if(sort==="az") arr.sort((a,b)=>a.l.name.localeCompare(b.l.name));
  else if(sort==="near") arr.sort((a,b)=>RANK[a.st.s]-RANK[b.st.s] || (a.st.total||0)-(b.st.total||0) || a.l.name.localeCompare(b.l.name));
  else if(sort==="bonus") arr.sort((a,b)=>b.l.bonus-a.l.bonus || a.l.name.localeCompare(b.l.name));
  const PER=20, pg=pager("all",arr.length,PER);
  let h="", lastG=null;
  pageOf("all",arr,PER).forEach(({l})=>{
    if(sort==="group" && l.group!==lastG){ h+=`<div class="grp">${esc(l.group)}</div>`; lastG=l.group; }
    h+=rowHtml(l);
  });
  document.getElementById("allCount").textContent = rangeTxt("all",arr.length,PER, arr.length===1?"carta":"cartas");
  const list=document.getElementById("list");
  list.innerHTML = arr.length? h : `<div class="empty">Nenhuma carta com esse filtro.</div>`;
  document.getElementById("allPager").innerHTML = pg;
  restoreOpen(list);
}
function renderMe(){
  document.getElementById("rating").value = S.rating||"";
  document.getElementById("items").innerHTML = ITEMS.map(([n])=>`<button class="tog" data-item="${esc(n)}" aria-pressed="${!!S.items[n]}">${dot(n)}${esc(n)}<span class="tick">✓</span></button>`).join("");
  document.getElementById("itemsN").textContent = ITEMS.filter(i=>S.items[i[0]]).length+"/"+ITEMS.length;
  renderUnlocks();
}
const UGROUPS=[["all","Todos",()=>true],["char","Personagens",u=>!RECIPES.has(u)&&!isOrder(u)],["recipe","Receitas",u=>RECIPES.has(u)],["order","Pedidos",u=>isOrder(u)]];
const USTATS=[["all","Todos"],["no","Não marcados"],["yes","Marcados"]];
function renderUnlocks(){
  document.getElementById("ugroup").innerHTML = UGROUPS.map(([k,t])=>`<button class="chip" data-ug="${k}" aria-pressed="${uGroup===k}">${t}</button>`).join("");
  document.getElementById("ustat").innerHTML = USTATS.map(([k,t])=>`<button class="chip" data-us="${k}" aria-pressed="${uStat===k}">${t}</button>`).join("");
  const uq=document.getElementById("uq").value.trim().toLowerCase();
  const gf=UGROUPS.find(g=>g[0]===uGroup)[2];
  const us=UNLOCKS.filter(gf).filter(u=>!uq||u.toLowerCase().includes(uq))
    .filter(u=>uStat==="all"||(uStat==="yes")===!!S.unl[u]);
  const PER=24, pg=pager("unl",us.length,PER);
  document.getElementById("unlocks").innerHTML = us.length ? pageOf("unl",us,PER).map(u=>`<button class="tog" data-unl="${esc(u)}" aria-pressed="${!!S.unl[u]}">${esc(u)}<span class="tick">✓</span></button>`).join("") : `<div class="empty" style="grid-column:1/-1">Nada encontrado.</div>`;
  document.getElementById("uPager").innerHTML = pg;
  document.getElementById("uCount").textContent = rangeTxt("unl",us.length,PER,"itens");
  document.getElementById("unlN").textContent = UNLOCKS.filter(u=>S.unl[u]).length+"/"+UNLOCKS.length;
}
function header(){
  const done=LETTERS.filter(l=>S.got[l.name]).length;
  document.getElementById("cnt").textContent=done+"/"+LETTERS.length;
  document.getElementById("barfill").style.width=(done/LETTERS.length*100)+"%";
}
function restoreOpen(root){ root.querySelectorAll("details.row").forEach(d=>{ if(openSet.has(d.dataset.n)) d.open=true; }); }
function render(){ header(); if(tab==="now") renderNow(); else if(tab==="all") renderAll(); else renderMe(); }

let tt; function toast(m){ const t=document.getElementById("toast"); t.textContent=m; t.hidden=false; clearTimeout(tt); tt=setTimeout(()=>t.hidden=true,1800); }

// ---- events ----
function setTab(t){ tab=t; ["now","all","me"].forEach(k=>{ document.getElementById("p-"+k).hidden = k!==t; document.getElementById("t-"+k).setAttribute("aria-selected", k===t); }); render(); window.scrollTo({top:0}); }
document.querySelector("nav.tabs").addEventListener("click",e=>{ const b=e.target.closest("[data-tab]"); if(b) setTab(b.dataset.tab); });
document.addEventListener("toggle",e=>{ const d=e.target; if(d.matches&&d.matches("details.row")){ d.open?openSet.add(d.dataset.n):openSet.delete(d.dataset.n); } },true);
document.addEventListener("click",e=>{
  const g=e.target.closest("[data-got]");
  if(g){ e.preventDefault(); const n=g.dataset.got; if(S.got[n]) delete S.got[n]; else { S.got[n]=1; toast("Recebida: "+n); } save(); render(); return; }
  const go=e.target.closest("[data-goto]"); if(go){ setTab(go.dataset.goto); return; }
  const f=e.target.closest("[data-f]"); if(f){ fStatus=f.dataset.f; PG.all=1; renderAll(); return; }
  const pgb=e.target.closest("[data-pg]"); if(pgb && !pgb.disabled){ const [k,n]=pgb.dataset.pg.split(":"); PG[k]=+n;
    if(k==="unl") renderUnlocks(); else if(k==="all") renderAll(); else renderNow();
    const anchor = k==="all"? document.getElementById("allCount") : k==="unl"? document.getElementById("uq") : pgb.closest("div").parentElement;
    const y = anchor.getBoundingClientRect().top + window.scrollY - 80; window.scrollTo({top:Math.max(0,y)}); return; }
  const ug=e.target.closest("[data-ug]"); if(ug){ uGroup=ug.dataset.ug; PG.unl=1; renderUnlocks(); return; }
  const us=e.target.closest("[data-us]"); if(us){ uStat=us.dataset.us; PG.unl=1; renderUnlocks(); return; }
  const it=e.target.closest("[data-item]"); if(it){ const n=it.dataset.item; S.items[n]=!S.items[n]; if(!S.items[n]) delete S.items[n]; save(); render(); return; }
  const u=e.target.closest("[data-unl]"); if(u){ const n=u.dataset.unl; S.unl[n]=!S.unl[n]; if(!S.unl[n]) delete S.unl[n]; save(); header(); u.setAttribute("aria-pressed",!!S.unl[n]); document.getElementById("unlN").textContent = UNLOCKS.filter(x=>S.unl[x]).length+"/"+UNLOCKS.length; return; }
});
document.getElementById("fitem").innerHTML += ITEMS.map(([n])=>`<option value="${esc(n)}">Usa: ${esc(n)}</option>`).join("");
const resetAll=()=>{ PG.all=1; renderAll(); };
document.getElementById("q").addEventListener("input",resetAll);
["fsec","fitem","fsort"].forEach(id=>document.getElementById(id).addEventListener("change",resetAll));
const resetNow=()=>{ PG.ready=1; PG.almost=1; renderNow(); };
document.getElementById("nq").addEventListener("input",resetNow);
["nsec","nsort"].forEach(id=>document.getElementById(id).addEventListener("change",resetNow));
document.getElementById("uq").addEventListener("input",()=>{ PG.unl=1; renderUnlocks(); });
document.getElementById("rating").addEventListener("input",e=>{ S.rating=Math.max(0,parseInt(e.target.value||"0",10)||0); save(); header(); });

// backup
document.getElementById("exp").addEventListener("click",()=>{
  const code = btoa(unescape(encodeURIComponent(JSON.stringify(S))));
  const ta=document.getElementById("expTxt"); ta.value=code; ta.hidden=false;
  const done=()=>toast("Código copiado");
  try{ navigator.clipboard.writeText(code).then(done,()=>{ ta.select(); toast("Selecionei o código: copie e guarde"); }); }
  catch(e){ ta.select(); toast("Selecionei o código: copie e guarde"); }
});
document.getElementById("impOpen").addEventListener("click",()=>{ const b=document.getElementById("impBox"); b.hidden=!b.hidden; });
document.getElementById("impGo").addEventListener("click",()=>{
  try{ const o=JSON.parse(decodeURIComponent(escape(atob(document.getElementById("impTxt").value.trim()))));
    if(!o||typeof o!=="object"||!("got" in o)) throw 0;
    S=Object.assign({got:{},items:{},unl:{},rating:0},o); save(); render(); toast("Progresso restaurado"); document.getElementById("impBox").hidden=true;
  }catch(e){ toast("Código inválido. Confira se colou o código inteiro."); }
});
// reset with in-page confirm
document.getElementById("resetBox").addEventListener("click",e=>{
  const box=document.getElementById("resetBox");
  if(e.target.id==="reset1"){ box.innerHTML=`<span class="note" style="align-self:center">Tem certeza? Isso apaga tudo.</span><button class="btn danger" id="reset2">Sim, apagar</button><button class="btn ghost" id="reset0">Cancelar</button>`; }
  else if(e.target.id==="reset2"){ S={got:{},items:{},unl:{},rating:0}; save(); box.innerHTML=`<button class="btn ghost" id="reset1">Apagar todo o progresso</button>`; render(); toast("Progresso apagado"); }
  else if(e.target.id==="reset0"){ box.innerHTML=`<button class="btn ghost" id="reset1">Apagar todo o progresso</button>`; }
});
render();
</script>
