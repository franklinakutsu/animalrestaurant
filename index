const esc = s => String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
function dot(name){ const c = ITEM_COLOR[name]; if(!c) return "";
  const bg = c[2] ? `radial-gradient(circle,${c[2]} 32%,${c[1]} 36%)` : c[1];
  return `<span class="dot" style="background:${bg}"></span>`; }
function itemHtml(name, miss){ return name==="*" ? `<span class="it">qualquer</span>` : `<span class="it${miss?' miss':''}">${dot(name)}${esc(name)}</span>`; }

// ---- status ----
function unlockOk(u){ return u.split(" or ").some(x=>S.unl[x]); }
function status(l){
  if(S.got[l.name]) return {s:"done"};
  if(l.kind==="event") return {s:"event"};
  const pre = [];
  l.preLetters.forEach(p=>{ if(!S.got[p]) pre.push({t:"Receber a carta "+p, kind:"letter"}); });
  l.preUnlocks.forEach(u=>{ if(!unlockOk(u)) pre.push({t:"Desbloquear "+u, kind:"unl"}); });
  if(l.rating && (S.rating||0) < l.rating) pre.push({t:"Chegar a "+l.rating.toLocaleString("pt-BR")+" de avaliação", kind:"rating"});
  let best=null;
  l.combos.forEach(c=>{ const miss=[...new Set(c.filter(i=>i!=="*" && !S.items[i]))]; if(!best || miss.length<best.miss.length) best={c,miss}; });
  const total = pre.length + best.miss.length;
  return {s: total===0?"ready": total===1?"almost":"lock", pre, best, total};
}
const PILL = {ready:["p-ready","Pronta"],almost:["p-almost","Falta 1"],lock:["p-lock","Bloqueada"],event:["p-event","Só evento"],done:["p-done","Recebida"]};

// ---- best combos (greedy set cover over ready letters) ----
function suggestions(ready){
  const owned = ITEMS.map(i=>i[0]).filter(i=>S.items[i]);
  const pool = ready.filter(l=>!l.anyCombo);
  if(!owned.length || !pool.length) return [];
  const cands=[];
  for(let a=0;a<owned.length;a++)for(let b=a;b<owned.length;b++)for(let c=b;c<owned.length;c++) cands.push([owned[a],owned[b],owned[c]]);
  const fits=(cand,combo)=>{ const bag=[...cand]; for(const i of combo){ if(i==="*") continue; const k=bag.indexOf(i); if(k<0) return false; bag.splice(k,1);} return true; };
  const match = cands.map(cand=>({cand, ls: pool.filter(l=>l.combos.some(co=>fits(cand,co)))}));
  // simplest slot set: prefer fewer distinct requirements -> show "*" for unused slots
  const out=[]; let left=new Set(pool.map(l=>l.name));
  for(let r=0;r<3 && left.size;r++){
    let top=null;
    for(const m of match){ const n=m.ls.filter(l=>left.has(l.name)); if(!n.length) continue;
      const score=n.length*1000+n.reduce((s,l)=>s+l.bonus,0);
      if(!top||score>top.score) top={cand:m.cand, ls:n, score}; }
    if(!top) break;
    // which slots actually matter for these letters
    const need=[]; top.ls.forEach(l=>{ const co=l.combos.find(co=>fits(top.cand,co)); const req=co.filter(i=>i!=="*");
      const bag=[...need]; req.forEach(i=>{ const k=bag.indexOf(i); if(k>=0) bag.splice(k,1); else need.push(i); }); });
    // re-check: if need fits in 3, display need + "*" padding, recompute letters it covers
    const shown = need.length<=3 ? [...need, ...Array(3-need.length).fill("*")] : top.cand;
    const cover = need.length<=3 ? top.ls.filter(l=>l.combos.some(co=>fits(need,co))) : top.ls;
    const final = cover.length===top.ls.length ? {slots:shown, ls:top.ls} : {slots:top.cand, ls:top.ls};
    out.push(final); final.ls.forEach(l=>left.delete(l.name));
  }
  return out;
}

// ---- render: row ----
function rowHtml(l){
  const st = status(l), [pc,pt] = PILL[st.s];
  let sub = [];
  if(l.seasonal) sub.push("mais chance: "+l.seasonal.replace(/^from /,""));
  const subTxt = sub.length? `<em>${esc(sub.join(" · "))}</em>` : "";
  let det = "";
  if(l.kind==="garden"){
    if(l.anyCombo){ det += `<div><h4>Combinação</h4>Qualquer item (ou espaços vazios)</div>`; }
    else{
      det += `<div class="combos"><h4>Combinação${l.combos.length>1?"ões (qualquer uma)":""}</h4>`+
        l.combos.map(c=>`<div>${c.map(i=>itemHtml(i, i!=="*" && !S.items[i])).join("")}</div>`).join("")+`</div>`;
    }
    const reqs=[];
    l.preLetters.forEach(p=>reqs.push([S.got[p],"Carta: "+p]));
    l.preUnlocks.forEach(u=>reqs.push([unlockOk(u),u]));
    if(l.rating) reqs.push([(S.rating||0)>=l.rating,"Avaliação "+l.rating.toLocaleString("pt-BR")]);
    if(reqs.length) det += `<div><h4>Antes precisa de</h4><ul class="req">${reqs.map(([ok,t])=>`<li class="${ok?'ok':'no'}">${ok?'✓':'✗'} ${esc(t)}</li>`).join("")}</ul></div>`;
    if(l.event && !l.seasonal) det += `<div><span class="tag">Carta de época: ${esc(l.event)}</span></div>`;
  } else {
    det += `<div><h4>Como conseguir</h4>${l.how.length? l.how.map(h=>`<div class="note">${esc(h)}</div>`).join("") : '<div class="note">Só durante evento.</div>'}</div>`;
  }
  if(l.unlocks.length) det += `<div><h4>Desbloqueia</h4><span class="note">${esc(l.unlocks.join(", "))}</span></div>`;
  if(l.bonus) det += `<div class="note">+${l.bonus} de avaliação</div>`;
  return `<details class="row" data-n="${esc(l.name)}"><summary>
    <button class="chk" aria-pressed="${!!S.got[l.name]}" aria-label="Marcar ${esc(l.name)} como recebida" data-got="${esc(l.name)}">${S.got[l.name]?'✓':''}</button>
    <span class="nm"><b>${esc(l.name)}</b>${subTxt}</span>
    <span class="pill ${pc}">${pt}</span></summary><div class="det">${det}</div></details>`;
}
function missingLine(st){
  const parts = [...st.best.miss.map(i=>"item "+i), ...st.pre.map(p=>p.t.replace(/^Desbloquear /,"").replace(/^Receber a carta /,"carta ").replace(/^Chegar a /,"avaliação "))];
  return parts.join(", ");
}

