<title>Correio do Jardim</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sniglet:wght@400;800&family=Nunito:wght@400;600;700;800&display=swap">
<style>
/* Layout: one narrow phone column; airmail-stripe header, tabs, then a paper sheet of letters */
:root{
  --bg:#E9F0EE; --paper:#FFFFFF; --paper-2:#F4F7F6; --ink:#24313A; --muted:#62717A; --line:#D5DFDC;
  --red:#C9413A; --blue:#2D5AA6; --green:#2F8552; --green-bg:#E0F2E7; --amber:#A8670F; --amber-bg:#FBEFD9;
  --grey-bg:#ECEFF0; --red-bg:#FBE4E2;
  --f-display:"Sniglet","Nunito",system-ui,sans-serif;
  --f-body:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  --r:14px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#12181C; --paper:#1B2328; --paper-2:#222C32; --ink:#E6ECEE; --muted:#9AA8AF; --line:#2F3A41;
  --red:#EE7B70; --blue:#86A9EA; --green:#6CC58E; --green-bg:#173A27; --amber:#F0B65E; --amber-bg:#3A2C14;
  --grey-bg:#262F35; --red-bg:#3D1F1D; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12181C; --paper:#1B2328; --paper-2:#222C32; --ink:#E6ECEE; --muted:#9AA8AF; --line:#2F3A41;
  --red:#EE7B70; --blue:#86A9EA; --green:#6CC58E; --green-bg:#173A27; --amber:#F0B65E; --amber-bg:#3A2C14;
  --grey-bg:#262F35; --red-bg:#3D1F1D; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.45}
.wrap{max-width:640px;margin:0 auto;padding-inline:16px;padding-block:0 calc(100px + env(safe-area-inset-bottom,0px))}
.stripe{height:8px;background:repeating-linear-gradient(-45deg,var(--red) 0 14px,var(--paper) 14px 22px,var(--blue) 22px 36px,var(--paper) 36px 44px)}
header{padding-block:18px 10px;display:flex;gap:14px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap}
h1{font-family:var(--f-display);font-weight:800;font-size:1.9rem;line-height:1;margin:0;text-wrap:balance}
h1 small{display:block;font-family:var(--f-body);font-weight:600;font-size:.82rem;color:var(--muted);margin-top:6px;letter-spacing:.01em}
.stamp{border:2px dashed var(--red);border-radius:6px;padding:6px 10px;text-align:center;font-variant-numeric:tabular-nums;color:var(--red);transform:rotate(-3deg)}
.stamp b{display:block;font-family:var(--f-display);font-size:1.25rem;line-height:1}
.stamp span{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}
.bar{height:6px;border-radius:6px;background:var(--line);overflow:hidden;margin-bottom:14px}
.bar i{display:block;height:100%;background:var(--green);border-radius:6px;transition:width .3s}
nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:10;background:var(--paper);border-top:1px solid var(--line);display:flex;justify-content:center;padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px))}
nav.tabs button{flex:1;max-width:200px;display:flex;flex-direction:column;align-items:center;gap:2px;font:inherit;font-weight:800;font-size:.74rem;padding:4px;border:0;border-radius:12px;background:transparent;color:var(--muted);cursor:pointer}
nav.tabs .ic{display:grid;place-items:center;width:56px;height:30px;border-radius:999px;transition:background .2s}
nav.tabs svg{width:22px;height:22px}
nav.tabs button[aria-selected="true"]{color:var(--blue)}
nav.tabs button[aria-selected="true"] .ic{background:var(--paper-2);box-shadow:inset 0 0 0 1.5px var(--blue)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
section.panel{display:flex;flex-direction:column;gap:18px;padding-top:8px}
h2{font-family:var(--f-display);font-weight:400;font-size:1.25rem;margin:0 0 8px;display:flex;gap:8px;align-items:baseline}
h2 .n{font-family:var(--f-body);font-weight:800;font-size:.8rem;color:var(--muted)}
.hint{color:var(--muted);font-size:.88rem;margin:0 0 10px}
.sheet{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.empty{padding:18px;color:var(--muted);text-align:center}
/* combo suggestion */
.combo{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:14px;display:flex;flex-direction:column;gap:10px}
.combo.top{border:2px solid var(--blue)}
.combo-head{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.slots{display:flex;gap:6px;flex-wrap:wrap}
.slot{display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:10px;background:var(--paper-2);border:1px solid var(--line);font-weight:800;font-size:.88rem}
.slot.any{color:var(--muted);font-weight:600}
.combo-n{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--blue)}
.combo ul{margin:0;padding-left:18px;font-size:.88rem;color:var(--muted)}
/* item dot */
.dot{width:12px;height:12px;border-radius:50%;flex:none;border:1px solid rgba(0,0,0,.18);display:inline-block}
.it{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
.it.miss{color:var(--red);text-decoration:underline wavy;text-underline-offset:3px}
/* letter row */
.grp{padding:8px 14px;background:var(--paper-2);font-size:.74rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-top:1px solid var(--line)}
.grp:first-child{border-top:0}
details.row{border-top:1px solid var(--line)}
.grp+details.row{border-top:1px solid var(--line)}
.sheet>details.row:first-child{border-top:0}
details.row summary{list-style:none;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:11px 14px;cursor:pointer}
details.row summary::-webkit-details-marker{display:none}
.chk{width:26px;height:26px;border-radius:7px;border:2px solid var(--line);background:var(--paper);display:grid;place-items:center;cursor:pointer;padding:0;color:var(--paper);font-weight:800}
.chk[aria-pressed="true"]{background:var(--green);border-color:var(--green)}
.nm{min-width:0}
.nm b{display:block;font-weight:700;overflow-wrap:anywhere}
.nm em{font-style:normal;font-size:.8rem;color:var(--muted);display:block}
.pill{font-size:.72rem;font-weight:800;padding:3px 9px;border-radius:999px;white-space:nowrap}
.p-ready{background:var(--green-bg);color:var(--green)}
.p-almost{background:var(--amber-bg);color:var(--amber)}
.p-lock{background:var(--grey-bg);color:var(--muted)}
.p-event{background:var(--red-bg);color:var(--red)}
.p-done{background:var(--green);color:var(--paper)}
.det{padding:0 14px 14px 50px;display:flex;flex-direction:column;gap:8px;font-size:.88rem}
.det h4{margin:0;font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
.det .combos{display:flex;flex-direction:column;gap:4px}
.det .combos div{display:flex;gap:10px;flex-wrap:wrap}
.req{display:flex;flex-direction:column;gap:3px;margin:0;padding:0;list-style:none}
.req li.ok{color:var(--green)}
.req li.no{color:var(--red)}
.note{color:var(--muted)}
.tag{display:inline-block;font-size:.75rem;font-weight:700;padding:2px 8px;border-radius:6px;background:var(--amber-bg);color:var(--amber)}
/* filters */
.tools{display:flex;flex-direction:column;gap:10px}
input[type=search],input[type=number],textarea,select{font:inherit;width:100%;padding:11px 12px;border-radius:12px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font:inherit;font-size:.82rem;font-weight:800;padding:7px 12px;border-radius:999px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.chip:disabled{opacity:.4;cursor:default}
.selects{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}
.count{font-size:.82rem;color:var(--muted);font-weight:700;font-variant-numeric:tabular-nums}
.pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:10px;font-weight:800;font-size:.86rem;font-variant-numeric:tabular-nums}
/* my game */
.items{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.tog{font:inherit;display:flex;align-items:center;gap:8px;padding:11px 12px;border-radius:12px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);font-weight:700;cursor:pointer;text-align:left}
.tog[aria-pressed="true"]{border-color:var(--green);background:var(--green-bg)}
.tog .tick{margin-left:auto;font-weight:800;color:var(--green);visibility:hidden}
.tog[aria-pressed="true"] .tick{visibility:visible}
.unl{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px}
.unl .tog{padding:9px 11px;font-size:.88rem}
.btn{font:inherit;font-weight:800;padding:11px 16px;border-radius:12px;border:0;background:var(--blue);color:var(--paper);cursor:pointer}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink)}
.btn.danger{background:var(--red)}
.row-btns{display:flex;gap:8px;flex-wrap:wrap}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:10px 16px;border-radius:999px;font-weight:700;font-size:.88rem;z-index:20}
.welcome{background:var(--paper);border:2px dashed var(--blue);border-radius:var(--r);padding:16px;display:flex;flex-direction:column;gap:10px}
.welcome p{margin:0}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="stripe" aria-hidden="true"></div>
<div class="wrap">
  <header>
    <h1>Correio do Jardim<small>Cartas do Animal Restaurant: o que falta e o que já dá pra pegar</small></h1>
    <div class="stamp" aria-label="Cartas recebidas"><b id="cnt">0/0</b><span>recebidas</span></div>
  </header>
  <div class="bar" aria-hidden="true"><i id="barfill" style="width:0"></i></div>

  <nav class="tabs" role="tablist">
    <button role="tab" id="t-now" aria-selected="true" data-tab="now"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.2 5.3L20 9l-4.4 3.8L17 18.5 12 15.6 7 18.5l1.4-5.7L4 9l5.8-.7z"/></svg></span>Agora</button>
    <button role="tab" id="t-all" aria-selected="false" data-tab="all"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg></span>Cartas</button>
    <button role="tab" id="t-me" aria-selected="false" data-tab="me"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="2.5"/><path d="M12 6.5c0-3 3.5-3 3.5 0M12 6.5c0-3-3.5-3-3.5 0M14.5 9c3 0 3 3.5 0 3.5M9.5 9c-3 0-3 3.5 0 3.5M12 11.5V21M12 17c-2.5 0-4-1.5-4.5-3.5M12 19c2.5 0 4-1.5 4.5-3.5"/></svg></span>Meu jogo</button>
  </nav>

  <section class="panel" id="p-now">
    <div id="nowTop" style="display:flex;flex-direction:column;gap:18px"></div>
    <div class="tools" id="nowTools">
      <input type="search" id="nq" placeholder="Buscar nas listas abaixo" autocomplete="off">
      <div class="selects">
        <select id="nsec" aria-label="Grupo">
          <option value="">Todos os grupos</option>
          <option value="Individual">Cartas individuais</option>
          <option value="Staff">Equipe</option>
          <option value="Customer">Clientes</option>
          <option value="Other">Jornal, feriados e preços</option>
        </select>
        <select id="nsort" aria-label="Ordenar">
          <option value="bonus">Ordenar: maior bônus</option>
          <option value="az">Ordenar: A–Z</option>
        </select>
      </div>
    </div>
    <div id="nowLists" style="display:flex;flex-direction:column;gap:18px"></div>
  </section>

  <section class="panel" id="p-all" hidden>
    <div class="tools">
      <input type="search" id="q" placeholder="Buscar carta ou personagem (ex.: Cici)" autocomplete="off">
      <div class="chips" id="fstatus"></div>
      <div class="selects">
        <select id="fsec" aria-label="Grupo">
          <option value="">Todos os grupos</option>
          <option value="Individual">Cartas individuais</option>
          <option value="Staff">Equipe</option>
          <option value="Customer">Clientes</option>
          <option value="Other">Jornal, feriados e preços</option>
        </select>
        <select id="fitem" aria-label="Item"><option value="">Qualquer item</option></select>
        <select id="fsort" aria-label="Ordenar">
          <option value="group">Ordenar: por grupo</option>
          <option value="near">Ordenar: mais perto de liberar</option>
          <option value="az">Ordenar: A–Z</option>
          <option value="bonus">Ordenar: maior bônus</option>
        </select>
      </div>
      <div class="count" id="allCount"></div>
    </div>
    <div class="sheet" id="list"></div>
    <div id="allPager"></div>
  </section>

  <section class="panel" id="p-me" hidden>
    <div>
      <h2>Avaliação (estrelas)</h2>
      <p class="hint">O número de avaliação do restaurante. Algumas cartas só chegam a partir de certa nota.</p>
      <input type="number" id="rating" inputmode="numeric" min="0" step="100" placeholder="ex.: 15000">
    </div>
    <div>
      <h2>Itens do jardim <span class="n" id="itemsN"></span></h2>
      <p class="hint">Marque as flores e regadores que você já tem para colocar nos espaços.</p>
      <div class="items" id="items"></div>
    </div>
    <div>
      <h2>Já desbloqueei <span class="n" id="unlN"></span></h2>
      <p class="hint">Personagens, receitas e pedidos que algumas cartas pedem antes.</p>
      <div class="tools" style="margin-bottom:10px">
        <input type="search" id="uq" placeholder="Buscar personagem, receita ou pedido" autocomplete="off">
        <div class="chips" id="ugroup"></div>
        <div class="chips" id="ustat"></div>
        <div class="count" id="uCount"></div>
      </div>
      <div class="unl" id="unlocks"></div>
      <div id="uPager"></div>
    </div>
    <div>
      <h2>Cópia de segurança</h2>
      <p class="hint">O progresso fica salvo neste celular. Se limpar os dados do navegador, ele some. Copie o código de vez em quando e guarde num bloco de notas.</p>
      <div class="row-btns"><button class="btn" id="exp">Copiar código</button><button class="btn ghost" id="impOpen">Restaurar de um código</button></div>
      <div id="impBox" hidden style="margin-top:10px;display:flex;flex-direction:column;gap:8px">
        <textarea id="impTxt" rows="3" placeholder="Cole o código aqui"></textarea>
        <div class="row-btns"><button class="btn" id="impGo">Restaurar</button></div>
      </div>
      <textarea id="expTxt" rows="3" readonly hidden style="margin-top:10px"></textarea>
    </div>
    <div>
      <h2>Recomeçar</h2>
      <div class="row-btns" id="resetBox"><button class="btn ghost" id="reset1">Apagar todo o progresso</button></div>
    </div>
  </section>
</div>
<div class="toast" id="toast" hidden></div>

